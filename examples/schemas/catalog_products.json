{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogProducts",
  "type": "array",
  "itemSelector": ".product-card, ._card_4b2",
  "required": ["title", "price"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Product display name in catalog card",
      "semanticRole": "heading",
      "initialSelector": ".title, h2, [role='heading']"
    },
    "price": {
      "type": "string",
      "description": "Product price in catalog card",
      "semanticRole": "price",
      "pattern": "[$€£¥₹]?\\s*[0-9]+([.,][0-9]{2})?",
      "initialSelector": ".price, span"
    }
  }
}
