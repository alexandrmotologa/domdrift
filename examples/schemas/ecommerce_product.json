{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EcommerceProduct",
  "type": "object",
  "required": ["title", "price"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Product display name or title",
      "semanticRole": "heading",
      "initialSelector": ".product-title, h1.title, [data-testid='product-title']"
    },
    "price": {
      "type": "string",
      "description": "Current selling price with currency symbol",
      "semanticRole": "price",
      "pattern": "[\\$\\€\\£\\¥]?\\s*[0-9]+([.,][0-9]{2})?",
      "initialSelector": ".product-price, .price-tag, [data-testid='price']"
    },
    "originalPrice": {
      "type": "string",
      "description": "Previous or crossed-out regular price if discounted",
      "semanticRole": "original-price",
      "initialSelector": ".original-price, .struck-price, [data-testid='original-price']"
    },
    "availability": {
      "type": "string",
      "description": "Stock availability status",
      "semanticRole": "status",
      "initialSelector": ".stock-status, .availability, [data-testid='stock']"
    },
    "rating": {
      "type": "string",
      "description": "Customer review rating score",
      "semanticRole": "rating",
      "initialSelector": ".rating-value, .stars-score, [data-testid='rating']"
    },
    "sku": {
      "type": "string",
      "description": "Item identification code or SKU",
      "semanticRole": "identifier",
      "initialSelector": ".sku-code, .product-sku, [data-testid='sku']"
    }
  }
}
